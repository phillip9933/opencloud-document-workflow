{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "erasableSyntaxOnly": true,
    "lib": [
      "ES2023"
    ]
  },
  "include": [
    "companion/**/*.mjs",
    "companion/**/*.d.mts",
    "tests/types/companion.ts"
  ],
  "exclude": [
    "node_modules",
    "companion/state"
  ]
}
