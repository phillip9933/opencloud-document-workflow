{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "erasableSyntaxOnly": true,
    "lib": [
      "ES2023"
    ]
  },
  "include": [
    "companion/runtime-owner.mjs",
    "companion/migrations.mjs",
    "companion/logging.mjs",
    "companion/http-handler.mjs",
    "companion/configuration.mjs",
    "companion/pagination.mjs",
    "companion/extract.mjs",
    "companion/ocr.mjs",
    "companion/health.mjs",
    "companion/listen.mjs",
    "companion/contracts.d.mts",
    "companion/filing.mjs",
    "companion/locations.mjs",
    "companion/preparation.mjs",
    "companion/transactions.mjs",
    "companion/similarity.mjs",
    "tests/types/companion.ts",
    "companion/http-body.mjs",
    "companion/api-errors.mjs",
    "companion/remote-transport.mjs",
    "companion/inbox.mjs",
    "companion/processing-history.mjs",
    "companion/metadata.mjs",
    "companion/pending-operations.mjs",
    "companion/transfers.mjs",
    "companion/document-trash.mjs",
    "companion/dav-response.mjs",
    "companion/provider-routing.mjs",
    "companion/intake-policy.mjs",
    "companion/services.mjs",
    "companion/file-listing.mjs",
    "companion/bulk-preparation.mjs"
  ],
  "exclude": [
    "node_modules",
    "companion/state"
  ]
}
